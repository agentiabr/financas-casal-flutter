<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_shopping_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_shopping_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_shopping_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROLPIG • LISTA DE COMPRAS"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#0284C7" />

            <TextView
                android:id="@+id/notif_shopping_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛒 Nova Lista de Compras"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_shopping_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toque para abrir a lista ou confirmar o recebimento."
                android:textSize="12sp"
                android:textColor="#334155"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_shopping_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/btn_notif_accept_shopping"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="#D1FAE5"
            android:gravity="center"
            android:text="✓ Recebi a lista"
            android:textColor="#065F46"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_notif_open_chat"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="#DBEAFE"
            android:gravity="center"
            android:text="💬 Ver no Chat"
            android:textColor="#1E40AF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
