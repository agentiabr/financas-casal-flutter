<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_activity_gradient"
    android:padding="20dp"
    android:gravity="center">

    <!-- Card Central do Alarme com Efeito Liquid Glass -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_liquid_glass_card"
        android:padding="26dp"
        android:gravity="center_horizontal"
        android:elevation="16dp">

        <!-- Badge Superior Neon Glass -->
        <TextView
            android:id="@+id/tv_alarm_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_alarm_badge"
            android:text="⏰ CONTROLPIG • ALARME DE SAÚDE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:letterSpacing="0.08"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Ícone Grande -->
        <TextView
            android:id="@+id/tv_alarm_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💊"
            android:textSize="54sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Título do Alarme -->
        <TextView
            android:id="@+id/tv_alarm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hora do Remédio"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <!-- Mensagem / Descrição do Alarme -->
        <TextView
            android:id="@+id/tv_alarm_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirme a conclusão ou adie por 5 minutos."
            android:textSize="14sp"
            android:textColor="#BAE6FD"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Botão 1: Concluído / Já Tomei (Verde Esmeralda Liquid) -->
        <Button
            android:id="@+id/btn_alarm_taken"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="✓ JÁ TOMEI / CONCLUÍDO"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_taken_liquid"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp" />

        <!-- Botão 2: Adiar 5 Minutos (Frosted Glass) -->
        <Button
            android:id="@+id/btn_alarm_snooze"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="💤 ADIAR 5 MINUTOS"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9"
            android:background="@drawable/bg_btn_snooze_liquid"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp" />

        <!-- Botão 3: Desligar Alarme (Ruby Red Liquid) -->
        <Button
            android:id="@+id/btn_alarm_dismiss"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🛑 DESLIGAR ALARME AGORA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_dismiss_liquid"
            android:stateListAnimator="@null" />

    </LinearLayout>
</RelativeLayout>
